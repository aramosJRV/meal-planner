{
  "manifest_version": 3,
  "name": "Meal Planner: fill my Coles trolley",
  "version": "1.1.0",
  "description": "Adds your Meal Planner shopping list to your own Coles trolley.",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://jrv-meal-planner.netlify.app/*"],
      "js": ["app.js"],
      "run_at": "document_start"
    },
    { "matches": ["https://www.coles.com.au/*"], "js": ["coles.js"] }
  ]
}
